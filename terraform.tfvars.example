# Copy to terraform.tfvars and fill in your values.
# See README.md for full guidance.

aws_region  = "eu-west-3"
tenant_name = "yourcompany"

company = {
  name      = "yourcompany"
  public_id = "yourcompany"
  domain    = "yourcompany.com"

  # SSO providers for login. Register the redirect URI
  # https://<name>.<root_domain>/sso/callback with each, then write the connector
  # JSON to Secrets Manager — see README.
  #
  # Empty is valid and is the right choice before you have picked an IdP: the
  # deployment then serves a username/password form instead, and terraform
  # generates the admin password into ewake/<tenant>/<company>/app under
  # ADMIN_PASSWORD for you to read out of Secrets Manager. Dex is not mounted at
  # all in that case. Adding a connector later switches login over.
  sso_connectors = ["google"]

  # cloudwatchMcpSidecar lets the agent read CloudWatch logs and metrics. It adds
  # a permanent container to the dashboard task, so it is off unless you need it.
  # Connect the CloudWatch integration in the dashboard *before* setting this — a
  # sidecar started with none connected stays down until the service is
  # redeployed. See README → "CloudWatch".
  # features = {
  #   cloudwatchMcpSidecar = true
  # }
}

# The build this deployment runs. Required, and a channel name ("stable",
# "latest") is refused: nothing migrates this database except an apply from this
# repo, and the image refuses to serve a schema behind it, so a tag that moves
# under you turns the next task replacement into an outage. Bump this to upgrade.
#
# Check the release notes for the version you want and set it here. Ewake keeps
# a limited number of builds, so a tag named here goes away eventually — a fresh
# install should name a recent one rather than copying this line unchanged.
app_image_tag = "ewake-v0.189.0"

root_domain    = "ewake.yourcompany.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Serve the dashboard at a name other than <company.name>.<root_domain> —
# typically root_domain itself, when the delegated zone is already the name you
# want. Optional; unset keeps the <company>.<root_domain> default.
# company_host = "ewake.yourcompany.com"

# If your hostname resolves from a private zone, or from a parent zone in an
# account this deployment cannot write to, set hosted_zone_id = null and supply
# your own certificate instead. You then own the A record and the certificate's
# renewal. See README → "If you can't delegate a public zone".
# hosted_zone_id      = null
# acm_certificate_arn = "arn:aws:acm:eu-west-3:123456789012:certificate/..."

# Only during a hostname cutover — serve the old and new names at once, then
# empty both. See README → "Changing the hostname of a running deployment".
# extra_certificate_arns = ["arn:aws:acm:eu-west-3:123456789012:certificate/..."]
# alb_extra_host_headers = ["old.yourcompany.com"]

# Two or more availability zones, all in aws_region. Leave unset if you set
# existing_network below: the zones are then whatever your subnets are in.
azs = ["eu-west-3a", "eu-west-3b"]

# Deploy into a VPC you already run, instead of having one created. For a central
# landing zone, or any account where the addressing is not yours to invent. No VPC,
# subnets, NAT gateways, route tables or routes are created; azs, vpc_cidr and
# transit_gateway_id stop applying. The private subnets must have egress, must span
# two availability zones, and must be reachable from wherever users open the
# dashboard. See README -> "Deploying into a VPC you already have".
# existing_network = {
#   vpc_id             = "vpc-0123456789abcdef0"
#   private_subnet_ids = ["subnet-0aaa...", "subnet-0bbb..."]
#
#   # Optional; used only for the S3 gateway endpoint, which is skipped without them.
#   private_route_table_ids = ["rtb-0aaa...", "rtb-0bbb..."]
#
#   # Only with alb_internal = false.
#   public_subnet_ids = ["subnet-0ccc...", "subnet-0ddd..."]
# }

# Reach the dashboard from your own network instead of the public internet.
# Attaches this VPC to a transit gateway already shared with this account — an
# org-level TGW shared via RAM, typically. Check `aws ec2 describe-transit-gateways`
# can see it before setting this. transit_gateway_routes are the CIDRs reached
# through it (a VPN range, say), added to every private route table; return
# traffic needs the TGW's own route table to propagate this VPC's CIDR, which is
# the TGW owner's side unless DefaultRouteTablePropagation is on.
# transit_gateway_id     = "tgw-0123456789abcdef0"
# transit_gateway_routes = ["10.38.0.0/23"]

# Optional overrides (defaults shown):
#
# Private deployment: no public ingress, dashboard reached over VPN, a peered
# network, or an SSM port-forward. Set both — `internal` removes the public IPs,
# the CIDR list is what actually refuses a packet. See README → Private deployments.
# alb_internal       = true
#
# With alb_internal, Slack and Datadog cannot reach the ALB. Point them at your own
# public entry point in front of it; the dashboard stays private either way.
# See README -> "Inbound webhooks on a private deployment".
# public_inbound_base_url = "https://ewake-inbound.example.com"
# alb_ingress_cidrs  = ["10.10.0.0/16", "10.38.0.0/23"]
#
# Container Insights is off by default: it bills per metric series and nothing
# in this deployment reads it. Per-task CPU and memory stay free under AWS/ECS
# either way. Set true for the per-container breakdown in the ECS console.
# container_insights = true
#
# Interface endpoints carry the AWS API calls this deployment makes (SSM,
# Secrets Manager, ECR, CloudWatch Logs) over PrivateLink. Unset means on when
# this deployment creates the VPC — the only path that works when NAT egress is
# filtered — and off with existing_network, where they usually exist already and
# AWS refuses a duplicate with private DNS. Each one bills hourly per availability
# zone. Set false to use the NAT path instead, only if egress from the private
# subnets is unrestricted; set true in an existing VPC that has none.
# vpc_interface_endpoints = false
#
# Only if your account's Lambda memory quota is still the 3008 MB a new AWS
# account starts with. The default is the 10240 maximum, and an apply against a
# capped account fails naming the ceiling. See README → "Lambda memory quota".
# reactive_lambda_memory_mb = 3008
#
# AWSDataLifecycleManagerDefaultRole is an account-global name that AWS creates
# itself the first time Data Lifecycle Manager is used. If your account already has
# it, set this false or the first apply fails with EntityAlreadyExists.
# create_dlm_default_role = false
#
# vpc_cidr           = "10.10.0.0/16"   # ignored with existing_network
# rds_instance_class = "db.t4g.small"
# rds_storage_gb     = 50
# rds_multi_az       = true
