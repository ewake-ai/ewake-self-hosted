# Copy to terraform.tfvars and fill in. See README.md for guidance.

aws_region  = "eu-west-3"
tenant_name = "acme"

company = {
  name      = "acme"
  public_id = "acme"
  domain    = "acme.com"

  # At least one, or nobody can log in. Register redirect URI
  # https://<company>.<root_domain>/sso/callback with the provider, then write the
  # connector JSON with scripts/set-dex-connector.sh.
  sso_connectors = ["google"]
}

root_domain    = "ewake.acme.corp"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Two or more availability zones, all in aws_region.
azs = ["eu-west-3a", "eu-west-3b"]

# Login is not shipped yet — a byoc deployment currently has no way to sign in,
# and nothing reads this variable. It is reserved for the Dex-based auth work;
# leave it commented out. See README.md → Post-install → Login.
# oidc_secret_arn = "arn:aws:secretsmanager:eu-west-3:<your-account>:secret:ewake/acme/oidc-AbCdEf"

# Optional overrides (defaults shown):
# ewake_aws_account_id = "058264427976"    # override only if Ewake has told you a different one
# release_channel      = "stable"
# vpc_cidr             = "10.10.0.0/16"
# rds_instance_class   = "db.t4g.small"
# rds_storage_gb       = 50
# rds_multi_az         = true
