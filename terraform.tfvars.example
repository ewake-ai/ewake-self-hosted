# Copy to terraform.tfvars and fill in your values.
# See README.md for full guidance.

aws_region  = "eu-west-3"
tenant_name = "yourcompany"

company = {
  name      = "yourcompany"
  public_id = "yourcompany"
  domain    = "yourcompany.com"

  # SSO providers for login. At least one is required.
  # Register redirect URI: https://<name>.<root_domain>/sso/callback
  # Then configure via scripts/set-dex-connector.sh.
  sso_connectors = ["google"]
}

root_domain    = "ewake.yourcompany.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Two or more availability zones, all in aws_region.
azs = ["eu-west-3a", "eu-west-3b"]

# Optional overrides (defaults shown):
# release_channel    = "stable"
# vpc_cidr           = "10.10.0.0/16"
# rds_instance_class = "db.t4g.small"
# rds_storage_gb     = 50
# rds_multi_az       = true
